# Copy this file to .env (same folder) and fill in your values.
# .env stays on your computer. Never share it or put it on GitHub.

# Claude API key from https://console.anthropic.com
# Leave it blank to type job details in yourself instead.
ANTHROPIC_API_KEY=

# MySQL connection
DB_PASSWORD=
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_search_tracker

# Optional: a cheaper model for reading postings (the default is claude-sonnet-5)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
